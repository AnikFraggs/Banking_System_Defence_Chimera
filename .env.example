# Local-only defaults. HTTP mode is for PayPal sandbox test accounts only;
# never use real cards or real PayPal buyer/merchant accounts.
PAYPAL_MODE=stub
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Vite settings are build-time values for local `npm run dev` (not secrets).
VITE_API_URL=/api
VITE_PAYPAL_STUB=true
VITE_PAYPAL_CLIENT_ID=

FRAUD_GATE_BASE_URL=http://fraud-gate:8001
FRAUD_GATE_TIMEOUT_MS=300
FRAUD_GATE_TRANSPORT=grpc
FRAUD_GATE_GRPC_TARGET=fraud-gate-grpc:50051
MODEL_ARTIFACT_PATH=/artifacts/creditcard_hgb.joblib
REDIS_URL=redis://redis:6379/0
WORKER_NAME=fraud-gate-worker-local
EXPLANATION_BACKEND_URL=
LOG_LEVEL=INFO

# Optional runtime tightening policy (offline Safe-LCB artifact). Leave empty to
# disable; a malformed artifact is rejected and never weakens friction.
SAFE_LCB_POLICY_PATH=
# Optional Redis rolling graph counters (read-prior/write-after only).
GRAPH_COUNTERS_ENABLED=false
# Optional neural case retrieval. Set both or neither (bge-small-en-v1.5 + cross-encoder).
CASE_BI_ENCODER_MODEL=
CASE_CROSS_ENCODER_MODEL=

# Optional semantic L4 guard (in-process ONNX, <100M params). Leave empty to
# keep the deterministic L4 baseline.
CHIMERA_DEFENSE_L4_SEMANTIC_MODEL_PATH=
CHIMERA_DEFENSE_L4_SEMANTIC_VOCAB_PATH=

# Async analyst-case wiring on the Java side.
CHIMERA_CASES_ASYNC_RESULTS_ENABLED=true
CHIMERA_CASES_FEEDBACK_ENABLED=true

# Empty is allowed only for local ephemeral use. Persistent/shared deployments
# require a long random AUDIT_HMAC_KEY and a stable AUDIT_KEY_VERSION.
AUDIT_HMAC_KEY=
AUDIT_KEY_VERSION=local-v1
MANAGER_AUTH_KEY=manager-local-key

# The database password and manager key below are local-only defaults.
POSTGRES_USER=chimera
POSTGRES_PASSWORD=pass
POSTGRES_DB=chimera_db

# Optional published host ports (all bind to 127.0.0.1 in Compose).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
FRAUD_GATE_HOST_PORT=8001
FRAUD_GATE_GRPC_HOST_PORT=50051
PLATFORM_API_HOST_PORT=8080
WEB_HOST_PORT=5173
