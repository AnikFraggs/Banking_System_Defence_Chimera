{
  "uid": "chimera-fraud-gate", "title": "CHIMERA Fraud Gate", "schemaVersion": 39, "version": 3,
  "editable": true, "tags": ["chimera", "sandbox"], "refresh": "10s", "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Scoring services scrape status", "type": "stat", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}}, "targets": [{"refId": "A", "expr": "up{job=~\"fraud-gate|fraud-gate-grpc\"}", "legendFormat": "{{job}}"}]},
    {"id": 3, "title": "Card model loaded", "description": "One series per scoring service; not the L4 semantic model.", "type": "stat", "datasource": "Prometheus", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}}, "targets": [{"refId": "A", "expr": "chimera_fraud_gate_model_loaded", "legendFormat": "{{job}}"}]},
    {"id": 4, "title": "Redis server reachable by exporter", "description": "Exporter-to-Redis reachability, not an application connection probe.", "type": "stat", "datasource": "Prometheus", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}}, "targets": [{"refId": "A", "expr": "redis_up{job=\"redis\"}"}]},
    {"id": 5, "title": "Completed scoring decisions / second", "description": "Counts successful scoring responses, including fail-closed responses; transport comes from scrape labels.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "targets": [{"refId": "A", "expr": "sum by (transport) (rate(chimera_fraud_gate_scores_total[5m]))", "legendFormat": "{{transport}}"}]},
    {"id": 6, "title": "Scoring latency", "description": "Scoring-service processing time; excludes Java/network/settlement latency. Idle transports have no quantile observations.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ms", "min": 0}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, transport) (rate(chimera_fraud_gate_score_latency_ms_bucket[5m])))", "legendFormat": "p50 {{transport}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, transport) (rate(chimera_fraud_gate_score_latency_ms_bucket[5m])))", "legendFormat": "p95 {{transport}}"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, transport) (rate(chimera_fraud_gate_score_latency_ms_bucket[5m])))", "legendFormat": "p99 {{transport}}"}]},
    {"id": 7, "title": "Decisions by action and fallback", "description": "A CAPTURE decision is permission to capture, not proof of payment settlement. Fallback is a boolean, not a reason code.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "targets": [{"refId": "A", "expr": "sum by (action, fallback) (rate(chimera_fraud_gate_scores_total[5m]))", "legendFormat": "{{action}} fallback={{fallback}}"}]},
    {"id": 8, "title": "Fused risk score", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(chimera_fraud_gate_fusion_score_bucket[5m])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(chimera_fraud_gate_fusion_score_bucket[5m])))", "legendFormat": "p95"}]},
    {"id": 9, "title": "Component risk scores (p95)", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, component) (rate(chimera_fraud_gate_component_score_bucket[5m])))", "legendFormat": "{{component}}"}]},
    {"id": 10, "title": "Async debate delta and bound violations", "description": "Informational only; never changes the pre-capture decision. Python's signed histogram has no sum. Last delta is shown only after a published observation; violations count both bounds.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "short"}}, "targets": [{"refId": "A", "expr": "chimera_fraud_gate_llm_delta_last and (chimera_fraud_gate_llm_delta_count > 0)", "legendFormat": "last delta {{instance}}"}, {"refId": "B", "expr": "sum(chimera_fraud_gate_llm_delta_out_of_bounds_total)", "legendFormat": "outside [-0.05, +0.05]"}]},
    {"id": 11, "title": "Published explanations / second", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "targets": [{"refId": "A", "expr": "sum by (mode) (rate(chimera_fraud_gate_explanations_total[5m]))", "legendFormat": "{{mode}}"}]},
    {"id": 12, "title": "Historical case matches / second", "description": "Zero is valid until analyst-labelled historical cases are available.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "targets": [{"refId": "A", "expr": "sum(rate(chimera_fraud_gate_matched_cases_total[5m]))", "legendFormat": "retrieved cases"}]},
    {"id": 13, "title": "Auxiliary layers loaded", "description": "Optional synthetic-data research layers (account-opening, AML, web-attack). 0 means the layer fails closed to CHALLENGE.", "type": "stat", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 36, "w": 8, "h": 4}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}}, "targets": [{"refId": "A", "expr": "chimera_aux_layer_model_loaded", "legendFormat": "{{layer}}"}]},
    {"id": 14, "title": "Auxiliary decisions / second", "description": "Escalate-only: CHALLENGE means step-up, not block. Includes fail-closed responses.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 8, "y": 36, "w": 16, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "targets": [{"refId": "A", "expr": "sum by (layer, decision) (rate(chimera_aux_layer_scores_total[5m]))", "legendFormat": "{{layer}} {{decision}}"}]},
    {"id": 15, "title": "Auxiliary scoring latency", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 44, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ms", "min": 0}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, layer) (rate(chimera_aux_layer_latency_ms_bucket[5m])))", "legendFormat": "p50 {{layer}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, layer) (rate(chimera_aux_layer_latency_ms_bucket[5m])))", "legendFormat": "p95 {{layer}}"}]},
    {"id": 16, "title": "Auxiliary fail-closed rate", "description": "Fallback=true counts MODEL_UNAVAILABLE / INVALID_FEATURES responses that challenged rather than passed.", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 44, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "targets": [{"refId": "A", "expr": "sum by (layer) (rate(chimera_aux_layer_scores_total{fallback=\"true\"}[5m]))", "legendFormat": "{{layer}}"}]},
    {"id": 17, "title": "Auxiliary risk score (p95)", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 52, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, layer) (rate(chimera_aux_layer_score_bucket[5m])))", "legendFormat": "{{layer}}"}]}
  ]
}
