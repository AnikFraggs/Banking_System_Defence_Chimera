{
  "uid": "chimera-system", "title": "CHIMERA System Overview", "schemaVersion": 39, "version": 2,
  "editable": true, "refresh": "10s", "tags": ["chimera", "system"], "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id":1,"title":"PostgreSQL reachable from exporter","type":"stat","datasource":"Prometheus","gridPos":{"h":4,"w":4,"x":0,"y":0},"targets":[{"expr":"pg_up{job=\"postgres\"}","refId":"A"}],"fieldConfig":{"defaults":{"min":0,"max":1,"noValue":"UNOBSERVED","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":2,"title":"Redis reachable from exporter","description":"Does not probe each application's Redis connection.","type":"stat","datasource":"Prometheus","gridPos":{"h":4,"w":4,"x":4,"y":0},"targets":[{"expr":"redis_up{job=\"redis\"}","refId":"A"}],"fieldConfig":{"defaults":{"min":0,"max":1,"noValue":"UNOBSERVED","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":3,"title":"Prometheus scrape","type":"stat","datasource":"Prometheus","gridPos":{"h":4,"w":4,"x":8,"y":0},"targets":[{"expr":"up{job=\"prometheus\"}","refId":"A"}]},
    {"id":4,"title":"Grafana scrape","type":"stat","datasource":"Prometheus","gridPos":{"h":4,"w":4,"x":12,"y":0},"targets":[{"expr":"up{job=\"grafana\"}","refId":"A"}]},
    {"id":5,"title":"Jaeger scrape","type":"stat","datasource":"Prometheus","gridPos":{"h":4,"w":4,"x":16,"y":0},"targets":[{"expr":"up{job=\"jaeger\"}","refId":"A"}]},
    {"id":12,"title":"Named containers observed","description":"Zero means container discovery is broken or no named containers exist; VM-only totals are not per-container monitoring.","type":"stat","datasource":"Prometheus","gridPos":{"h":4,"w":4,"x":20,"y":0},"targets":[{"expr":"count(container_last_seen{job=\"cadvisor\",name!=\"\"}) or vector(0)","refId":"A"}],"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":6,"title":"Container CPU usage (cores)","description":"CPU seconds per second, not percent of quota. Empty when cAdvisor cannot discover containers.","type":"timeseries","datasource":"Prometheus","gridPos":{"h":8,"w":12,"x":0,"y":4},"targets":[{"expr":"sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}[5m]))","legendFormat":"{{name}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","min":0}}},
    {"id":7,"title":"Container memory / reported limit","description":"Empty when no container has a positive hard limit, including this unlimited Compose stack. Zero/unlimited limits are excluded; see the bytes panel for actual usage.","type":"timeseries","datasource":"Prometheus","gridPos":{"h":8,"w":12,"x":12,"y":4},"targets":[{"expr":"container_memory_usage_bytes{job=\"cadvisor\",name!=\"\"} / (container_spec_memory_limit_bytes{job=\"cadvisor\",name!=\"\"} > 0)","legendFormat":"{{name}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0}}},
    {"id":8,"title":"Container memory (bytes)","type":"timeseries","datasource":"Prometheus","gridPos":{"h":8,"w":12,"x":0,"y":12},"targets":[{"expr":"container_memory_usage_bytes{job=\"cadvisor\",name!=\"\"}","legendFormat":"{{name}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0}}},
    {"id":9,"title":"Container network I/O (bytes/s)","type":"timeseries","datasource":"Prometheus","gridPos":{"h":8,"w":12,"x":12,"y":12},"targets":[{"expr":"sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",name!=\"\"}[5m]))","legendFormat":"RX {{name}}","refId":"A"},{"expr":"sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",name!=\"\"}[5m]))","legendFormat":"TX {{name}}","refId":"B"}],"fieldConfig":{"defaults":{"unit":"Bps","min":0}}},
    {"id":10,"title":"Container disk I/O (bytes/s)","description":"Available only where the runtime exposes per-container block I/O.","type":"timeseries","datasource":"Prometheus","gridPos":{"h":8,"w":12,"x":0,"y":20},"targets":[{"expr":"sum by (name) (rate(container_fs_reads_bytes_total{job=\"cadvisor\",name!=\"\"}[5m]))","legendFormat":"Read {{name}}","refId":"A"},{"expr":"sum by (name) (rate(container_fs_writes_bytes_total{job=\"cadvisor\",name!=\"\"}[5m]))","legendFormat":"Write {{name}}","refId":"B"}],"fieldConfig":{"defaults":{"unit":"Bps","min":0}}},
    {"id":11,"title":"PostgreSQL activity (tuples/s)","type":"timeseries","datasource":"Prometheus","gridPos":{"h":8,"w":12,"x":12,"y":20},"targets":[{"expr":"rate(pg_stat_database_tup_fetched{job=\"postgres\",datname=\"chimera_db\"}[5m])","legendFormat":"Fetched","refId":"A"},{"expr":"rate(pg_stat_database_tup_inserted{job=\"postgres\",datname=\"chimera_db\"}[5m])","legendFormat":"Inserted","refId":"B"},{"expr":"rate(pg_stat_database_tup_updated{job=\"postgres\",datname=\"chimera_db\"}[5m])","legendFormat":"Updated","refId":"C"},{"expr":"rate(pg_stat_database_tup_deleted{job=\"postgres\",datname=\"chimera_db\"}[5m])","legendFormat":"Deleted","refId":"D"}],"fieldConfig":{"defaults":{"unit":"ops","min":0}}}
  ]
}
